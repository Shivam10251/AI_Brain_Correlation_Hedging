# Copy to .env and fill in.  cp env.example .env
#
# .env is gitignored and must never be committed. This file is named
# without the leading dot precisely so it CAN be tracked - .gitignore
# excludes ".env.*", which would have swallowed ".env.example".

# ---------------------------------------------------------------------
# API security (Phase 1)
# ---------------------------------------------------------------------
# Required before binding anything but 127.0.0.1. Every /api/* route
# except /api/health then needs "Authorization: Bearer <token>".
# The dashboards receive it server-side, so they keep working as-is.
#
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Set true only if you deliberately want an unauthenticated API on a
# non-loopback interface. Do not enable this on a VPS.
ALLOW_INSECURE_BIND=false


# ---------------------------------------------------------------------
# DeepSeek
# ---------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_TIMEOUT=30


# ---------------------------------------------------------------------
# Trading universe
# ---------------------------------------------------------------------
# Comma-separated. These MUST match the broker's exact symbol names -
# a name the broker does not offer is reported at startup and then
# skipped every cycle. Check the startup log or GET /api/meta/broker.
SYMBOLS=EURUSDm,GBPUSDm,BTCUSDm,XAUUSDm


# ---------------------------------------------------------------------
# Risk (defaults preserve pre-Phase-1 behaviour)
# ---------------------------------------------------------------------
SL_PERCENT=0.002
TP_PERCENT=0.004
LOT_SIZE=0.01
MAGIC_NUMBER=100001

# Deviation in basis points of price, converted to instrument-correct
# points at order time. Replaces the fixed DEVIATION=20, which meant
# 2 pips on EURUSD but $0.20 on BTCUSD.
DEVIATION_BPS=5

# 0 = disabled, preserving the original behaviour.
MAX_OPEN_POSITIONS_PER_SYMBOL=0
MIN_SCORE_TO_TRADE=0


# ---------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------
DEFAULT_INTERVAL=30
EQUITY_SNAPSHOT_MIN_SECONDS=60
PENDING_TRADE_TIMEOUT_SECONDS=120

# Whether a restart resumes trading. Keep false: an unattended
# crash-loop must not start firing orders on its own.
RESUME_ENGINE_ON_STARTUP=false


# ---------------------------------------------------------------------
# AI memory / news
# ---------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_MAX_EXPERIENCES=5

NEWS_ENABLED=false
NEWS_PROVIDER=null
NEWS_API_KEY=


# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Defaults to data/quantbot.db. Override only for tests.
DB_PATH=
