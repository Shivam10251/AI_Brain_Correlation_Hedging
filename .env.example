# =============================================================
# AI Hedge Fund — configuration
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored; this template is not.
# =============================================================

# --- DeepSeek LLM -------------------------------------------
# The API key the trading brain and the auditor both authenticate with.
# Without it every AI call fails and the engine will not place a trade.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- MetaTrader 5 terminal ----------------------------------
# Leave MT5_LOGIN blank to attach to whatever account the terminal is
# already logged into. Fill it in to force a specific account.
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Trial7

# Absolute path to terminal64.exe. Blank lets the MT5 package find it.
# Example: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# --- Risk and cadence ---------------------------------------
# Percent of ACCOUNT EQUITY risked per trade, measured to the stop loss.
# 1.0 means a full stop-out costs 1% of equity.
DEFAULT_RISK_PERCENT=1.0

# Seconds between complete scans of every symbol.
SCAN_INTERVAL_SECONDS=30

# Minimum AI confidence (0-100) required before an order may be sent.
# Anything below this is forced to HOLD.
CONFIDENCE_THRESHOLD=65

# --- Universe ------------------------------------------------
# Comma separated. The trailing "m" is this broker's naming for its
# micro-lot contracts; change it to match your own broker's symbols.
SYMBOLS=EURUSDm,GBPUSDm,USDJPYm,USDCHFm,USDCADm,AUDUSDm,NZDUSDm,BTCUSDm,XAUUSDm

# --- Self-learning auditor -----------------------------------
# How many newly closed trades accumulate before an audit is triggered.
AUDIT_TRADE_THRESHOLD=10

# Minimum hours between audits, unless one is forced from the dashboard.
AUDIT_COOLDOWN_HOURS=12
